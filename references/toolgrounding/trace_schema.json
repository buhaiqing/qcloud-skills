{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolCallTrace",
  "description": "工具调用 Grounding Trace 结构",
  "type": "object",
  "additionalProperties": false,
  "required": ["trace_id", "timestamp", "call", "grounding", "result"],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "全局唯一追踪 ID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 时间戳"
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "params", "reasoning"],
      "properties": {
        "tool_name": {
          "type": "string",
          "description": "工具名称"
        },
        "params": {
          "type": "object",
          "description": "工具参数"
        },
        "reasoning": {
          "type": "string",
          "description": "LLM 选择此工具的推理过程"
        },
        "intent": {
          "type": "string",
          "description": "用户原始意图（可选）"
        }
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "source", "constraints"],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "工具/参数选择置信度，0.0~1.0"
        },
        "source": {
          "type": "string",
          "enum": ["user_instruction", "skill_schema", "previous_result", "inferior_model", "fallback"],
          "description": "参数来源"
        },
        "constraints": {
          "type": "array",
          "items": {"type": "string"},
          "description": "应用的约束条件描述"
        },
        "inferior_model_hint": {
          "type": "string",
          "description": "当 source=inferior_model 时，记录底层模型名称"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "error_name"],
      "properties": {
        "error_code": {
          "type": "integer",
          "description": "错误码，0=成功"
        },
        "error_name": {
          "type": "string",
          "description": "错误码名称"
        },
        "data": {
          "type": "object",
          "description": "返回数据（成功时）"
        },
        "message": {
          "type": "string",
          "description": "错误信息或提示"
        },
        "duration_ms": {
          "type": "number",
          "description": "执行耗时（毫秒）"
        }
      }
    },
    "state_snapshot": {
      "type": "object",
      "description": "调用前的状态快照",
      "additionalProperties": false
    }
  }
}
